import { createFileRoute, useNavigate } from '@tanstack/react-router'
import { useEffect, useState, type FormEvent } from 'react'

import {
  AlertDialog,
  AlertDialogAction,
  AlertDialogCancel,
  AlertDialogContent,
  AlertDialogDescription,
  AlertDialogFooter,
  AlertDialogHeader,
  AlertDialogTitle,
} from '@/components/ui/alert-dialog'
import { Badge } from '@/components/ui/badge'
import { Button } from '@/components/ui/button'
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card'
import { Input } from '@/components/ui/input'
import { Label } from '@/components/ui/label'
import { Switch } from '@/components/ui/switch'
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table'
import { useI18n } from '@/i18n'
import { supabase } from '@/lib/supabase'

type SkillRow = {
  id: string
  name_en: string
  name_ar: string
  category: string
  icon: string | null
  display_order: number
  is_active: boolean
}

type SkillFormState = {
  name_en: string
  name_ar: string
  category: string
  icon: string
  display_order: string
  is_active: boolean
}

const categoryOptions = [
  { value: 'data-analysis', labelEn: 'Data Analysis', labelAr: 'تحليل البيانات' },
  { value: 'business-intelligence', labelEn: 'Business Intelligence', labelAr: 'ذكاء الأعمال' },
  { value: 'development', labelEn: 'Development', labelAr: 'التطوير' },
  { value: 'database', labelEn: 'Database', labelAr: 'قاعدة البيانات' },
  { value: 'other', labelEn: 'Other', labelAr: 'أخرى' },
] as const

const createEmptyFormState = (): SkillFormState => ({
  name_en: '',
  name_ar: '',
  category: 'development',
  icon: '',
  display_order: '1',
  is_active: true,
})

export const Route = createFileRoute('/admin/skills')({
  component: AdminSkillsPage,
})

function AdminSkillsPage() {
  const navigate = useNavigate()
  const { language, isRTL } = useI18n()

  const [checkingAccess, setCheckingAccess] = useState(true)
  const [skills, setSkills] = useState<SkillRow[]>([])
  const [loading, setLoading] = useState(true)
  const [submitting, setSubmitting] = useState(false)
  const [form, setForm] = useState<SkillFormState>(createEmptyFormState)
  const [editingSkillId, setEditingSkillId] = useState<string | null>(null)
  const [statusMessage, setStatusMessage] = useState<string | null>(null)
  const [statusType, setStatusType] = useState<'success' | 'error' | null>(null)
  const [deleteDialogOpen, setDeleteDialogOpen] = useState(false)
  const [skillToDelete, setSkillToDelete] = useState<SkillRow | null>(null)
  const [deletingSkill, setDeletingSkill] = useState(false)

  const loadSkills = async () => {
    setLoading(true)

    const { data, error } = await supabase
      .from('skills')
      .select('id,name_en,name_ar,category,icon,display_order,is_active')
      .order('display_order', { ascending: true })
      .order('name_en', { ascending: true })

    if (error) {
      setStatusMessage(language === 'ar' ? 'تعذر تحميل المهارات.' : 'Unable to load skills.')
      setStatusType('error')
      setSkills([])
      setLoading(false)
      return
    }

    setSkills((data as SkillRow[]) ?? [])
    setLoading(false)
  }

  useEffect(() => {
    const checkAccessAndLoad = async () => {
      const {
        data: { session },
        error: sessionError,
      } = await supabase.auth.getSession()

      if (sessionError || !session?.user) {
        await navigate({
          to: '/admin/login',
          search: { error: 'access_denied' },
        })
        return
      }

      const { data: adminProfile, error: profileError } = await supabase
        .from('admin_profiles')
        .select('role, is_active')
        .eq('user_id', session.user.id)
        .maybeSingle()

      if (
        profileError ||
        !adminProfile ||
        adminProfile.role !== 'admin' ||
        adminProfile.is_active !== true
      ) {
        console.error('Admin profile check failed:', profileError)
        await navigate({
          to: '/admin/login',
          search: { error: 'access_denied' },
        })
        return
      }

      setCheckingAccess(false)
      await loadSkills()
    }

    void checkAccessAndLoad()
  }, [])

  const updateField = (field: keyof SkillFormState, value: string | boolean) => {
    setForm((current) => ({ ...current, [field]: value }))
  }

  const resetForm = () => {
    setForm(createEmptyFormState())
    setEditingSkillId(null)
    setStatusMessage(null)
    setStatusType(null)
  }

  const validateForm = () => {
    if (!form.name_en.trim()) {
      return language === 'ar' ? 'يرجى إدخال اسم المهارة بالإنجليزية.' : 'Please enter the skill name in English.'
    }

    if (!form.name_ar.trim()) {
      return language === 'ar' ? 'يرجى إدخال اسم المهارة بالعربية.' : 'Please enter the skill name in Arabic.'
    }

    if (!form.category.trim()) {
      return language === 'ar' ? 'يرجى اختيار الفئة.' : 'Please select a category.'
    }

    const validCategory = categoryOptions.some((option) => option.value === form.category)
    if (!validCategory) {
      return language === 'ar' ? 'يرجى اختيار فئة صالحة.' : 'Please select a valid category.'
    }

    const displayOrder = Number(form.display_order)
    if (!Number.isInteger(displayOrder) || displayOrder < 0) {
      return language === 'ar' ? 'يرجى إدخال ترتيب عرض صحيح.' : 'Please enter a valid display order.'
    }

    return null
  }

  const handleSubmit = async (event: FormEvent<HTMLFormElement>) => {
    event.preventDefault()
    setStatusMessage(null)
    setStatusType(null)

    const validationMessage = validateForm()
    if (validationMessage) {
      setStatusMessage(validationMessage)
      setStatusType('error')
      return
    }

    const payload = {
      name_en: form.name_en.trim(),
      name_ar: form.name_ar.trim(),
      category: form.category,
      icon: form.icon.trim() ? form.icon.trim() : null,
      display_order: Number(form.display_order),
      is_active: form.is_active,
    }

    setSubmitting(true)

    if (editingSkillId) {
      const { error } = await supabase.from('skills').update(payload).eq('id', editingSkillId)

      if (error) {
        setStatusMessage(language === 'ar' ? 'تعذر تحديث المهارة.' : 'Unable to update the skill.')
        setStatusType('error')
        setSubmitting(false)
        return
      }

      setStatusMessage(language === 'ar' ? 'تم تحديث المهارة بنجاح.' : 'Skill updated successfully.')
      setStatusType('success')
    } else {
      const { error } = await supabase.from('skills').insert([payload])

      if (error) {
        setStatusMessage(language === 'ar' ? 'تعذر إنشاء المهارة.' : 'Unable to create the skill.')
        setStatusType('error')
        setSubmitting(false)
        return
      }

      setStatusMessage(language === 'ar' ? 'تم إنشاء المهارة بنجاح.' : 'Skill created successfully.')
      setStatusType('success')
    }

    setSubmitting(false)
    setEditingSkillId(null)
    setForm(createEmptyFormState())
    await loadSkills()
  }

  const handleEdit = (skill: SkillRow) => {
    setEditingSkillId(skill.id)
    setForm({
      name_en: skill.name_en,
      name_ar: skill.name_ar,
      category: skill.category,
      icon: skill.icon ?? '',
      display_order: String(skill.display_order),
      is_active: skill.is_active,
    })
    setStatusMessage(null)
    setStatusType(null)
  }

  const confirmDelete = (skill: SkillRow) => {
    setSkillToDelete(skill)
    setDeleteDialogOpen(true)
  }

  const handleDelete = async () => {
    if (!skillToDelete) {
      return
    }

    setDeletingSkill(true)
    const { error } = await supabase.from('skills').delete().eq('id', skillToDelete.id)

    if (error) {
      setStatusMessage(language === 'ar' ? 'تعذر حذف المهارة.' : 'Unable to delete the skill.')
      setStatusType('error')
      setDeletingSkill(false)
      setDeleteDialogOpen(false)
      setSkillToDelete(null)
      return
    }

    setStatusMessage(language === 'ar' ? 'تم حذف المهارة بنجاح.' : 'Skill deleted successfully.')
    setStatusType('success')
    setDeletingSkill(false)
    setDeleteDialogOpen(false)
    setSkillToDelete(null)
    await loadSkills()
  }

  if (checkingAccess) {
    return (
      <div
        className="flex min-h-screen items-center justify-center bg-background text-foreground"
        dir={isRTL ? 'rtl' : 'ltr'}
      >
        <p className="text-sm text-muted-foreground">
          {language === 'ar' ? 'جارٍ التحقق من صلاحية الوصول…' : 'Checking access…'}
        </p>
      </div>
    )
  }

  return (
    <div className="min-h-screen bg-background px-4 py-10 text-foreground" dir={isRTL ? 'rtl' : 'ltr'}>
      <div className="mx-auto flex max-w-7xl flex-col gap-6">
        <div className="flex flex-col gap-3 rounded-2xl border border-border/70 bg-card/70 p-6 shadow-sm sm:flex-row sm:items-center sm:justify-between">
          <div>
            <p className="text-sm font-medium uppercase tracking-[0.2em] text-muted-foreground">
              {language === 'ar' ? 'المهارات' : 'Skills'}
            </p>
            <h1 className="mt-2 text-3xl font-semibold tracking-tight">
              {language === 'ar' ? 'إدارة المهارات' : 'Skills management'}
            </h1>
            <p className="mt-2 text-sm text-muted-foreground">
              {language === 'ar'
                ? 'أنشئ أو عدّل أو احذف المهارات باستخدام بيانات Supabase الحالية.'
                : 'Create, edit, and delete skills using the current Supabase data.'}
            </p>
          </div>

          <div className="flex flex-wrap gap-2">
            <Button variant="outline" onClick={() => navigate({ to: '/admin/dashboard' })}>
              {language === 'ar' ? 'العودة إلى لوحة الإدارة' : 'Back to dashboard'}
            </Button>
            <Button onClick={resetForm}>
              {language === 'ar' ? 'مهارة جديدة' : 'New skill'}
            </Button>
          </div>
        </div>

        {statusMessage ? (
          <div className={`rounded-lg border px-4 py-3 text-sm ${statusType === 'success' ? 'border-emerald-500/30 bg-emerald-500/10 text-emerald-600' : 'border-destructive/30 bg-destructive/10 text-destructive'}`}>
            {statusMessage}
          </div>
        ) : null}

        <div className="grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
          <Card>
            <CardHeader>
              <CardTitle>{editingSkillId ? (language === 'ar' ? 'تعديل المهارة' : 'Edit skill') : (language === 'ar' ? 'إنشاء مهارة جديدة' : 'Create a new skill')}</CardTitle>
              <CardDescription>
                {language === 'ar' ? 'استخدم الحقول الثنائية للغة العربية والإنجليزية.' : 'Use the bilingual fields for Arabic and English content.'}
              </CardDescription>
            </CardHeader>
            <CardContent>
              <form className="space-y-4" onSubmit={handleSubmit}>
                <div className="grid gap-4 md:grid-cols-2">
                  <div className="space-y-2">
                    <Label htmlFor="name_en">{language === 'ar' ? 'الاسم بالإنجليزية' : 'English name'}</Label>
                    <Input id="name_en" value={form.name_en} onChange={(event) => updateField('name_en', event.target.value)} />
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="name_ar">{language === 'ar' ? 'الاسم بالعربية' : 'Arabic name'}</Label>
                    <Input id="name_ar" value={form.name_ar} onChange={(event) => updateField('name_ar', event.target.value)} />
                  </div>
                </div>

                <div className="grid gap-4 md:grid-cols-2">
                  <div className="space-y-2">
                    <Label htmlFor="category">{language === 'ar' ? 'الفئة' : 'Category'}</Label>
                    <select
                      id="category"
                      value={form.category}
                      onChange={(event) => updateField('category', event.target.value)}
                      className="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
                    >
                      {categoryOptions.map((option) => (
                        <option key={option.value} value={option.value}>
                          {language === 'ar' ? option.labelAr : option.labelEn}
                        </option>
                      ))}
                    </select>
                  </div>
                  <div className="space-y-2">
                    <Label htmlFor="display_order">{language === 'ar' ? 'ترتيب العرض' : 'Display order'}</Label>
                    <Input
                      id="display_order"
                      type="number"
                      min="0"
                      step="1"
                      value={form.display_order}
                      onChange={(event) => updateField('display_order', event.target.value)}
                    />
                  </div>
                </div>

                <div className="space-y-2">
                  <Label htmlFor="icon">{language === 'ar' ? 'الأيقونة' : 'Icon'}</Label>
                  <Input id="icon" value={form.icon} onChange={(event) => updateField('icon', event.target.value)} placeholder={language === 'ar' ? 'مثل: BarChart3' : 'e.g. BarChart3'} />
                </div>

                <div className="flex items-center justify-between rounded-lg border border-border/70 px-4 py-3">
                  <div>
                    <p className="text-sm font-medium">{language === 'ar' ? 'نشط' : 'Active'}</p>
                    <p className="text-sm text-muted-foreground">
                      {language === 'ar' ? 'إظهار المهارة في الواجهة العامة.' : 'Show the skill on the public portfolio.'}
                    </p>
                  </div>
                  <Switch checked={form.is_active} onCheckedChange={(checked) => updateField('is_active', checked)} />
                </div>

                <div className="flex flex-wrap gap-2">
                  <Button type="submit" disabled={submitting}>
                    {submitting
                      ? language === 'ar'
                        ? 'جارٍ الحفظ…'
                        : 'Saving…'
                      : editingSkillId
                        ? language === 'ar'
                          ? 'حفظ التغييرات'
                          : 'Save changes'
                        : language === 'ar'
                          ? 'إنشاء المهارة'
                          : 'Create skill'}
                  </Button>
                  <Button type="button" variant="outline" onClick={resetForm}>
                    {language === 'ar' ? 'إلغاء' : 'Cancel'}
                  </Button>
                </div>
              </form>
            </CardContent>
          </Card>

          <Card>
            <CardHeader>
              <CardTitle>{language === 'ar' ? 'قائمة المهارات' : 'Skills list'}</CardTitle>
              <CardDescription>
                {language === 'ar' ? 'ترتيب المهارات حسب ترتيب العرض.' : 'Skills are ordered by display order.'}
              </CardDescription>
            </CardHeader>
            <CardContent>
              {loading ? (
                <div className="flex min-h-[200px] items-center justify-center text-sm text-muted-foreground">
                  {language === 'ar' ? 'جارٍ تحميل المهارات…' : 'Loading skills…'}
                </div>
              ) : skills.length === 0 ? (
                <div className="flex min-h-[200px] items-center justify-center rounded-lg border border-dashed border-border/70 p-6 text-center text-sm text-muted-foreground">
                  {language === 'ar' ? 'لا توجد مهارات بعد.' : 'No skills yet.'}
                </div>
              ) : (
                <div className="overflow-x-auto">
                  <Table>
                    <TableHeader>
                      <TableRow>
                        <TableHead>{language === 'ar' ? 'الاسم' : 'Name'}</TableHead>
                        <TableHead>{language === 'ar' ? 'الفئة' : 'Category'}</TableHead>
                        <TableHead>{language === 'ar' ? 'الترتيب' : 'Order'}</TableHead>
                        <TableHead>{language === 'ar' ? 'الحالة' : 'Status'}</TableHead>
                        <TableHead className="text-right">{language === 'ar' ? 'الإجراءات' : 'Actions'}</TableHead>
                      </TableRow>
                    </TableHeader>
                    <TableBody>
                      {skills.map((skill) => (
                        <TableRow key={skill.id}>
                          <TableCell>
                            <div className="font-medium">{language === 'ar' ? skill.name_ar : skill.name_en}</div>
                            <div className="text-xs text-muted-foreground">{skill.icon ?? '—'}</div>
                          </TableCell>
                          <TableCell>
                            {categoryOptions.find((option) => option.value === skill.category)
                              ? language === 'ar'
                                ? categoryOptions.find((option) => option.value === skill.category)!.labelAr
                                : categoryOptions.find((option) => option.value === skill.category)!.labelEn
                              : skill.category}
                          </TableCell>
                          <TableCell>{skill.display_order}</TableCell>
                          <TableCell>
                            <Badge variant={skill.is_active ? 'default' : 'secondary'}>
                              {skill.is_active
                                ? language === 'ar'
                                  ? 'نشط'
                                  : 'Active'
                                : language === 'ar'
                                  ? 'غير نشط'
                                  : 'Inactive'}
                            </Badge>
                          </TableCell>
                          <TableCell>
                            <div className="flex justify-end gap-2">
                              <Button variant="outline" size="sm" onClick={() => handleEdit(skill)}>
                                {language === 'ar' ? 'تعديل' : 'Edit'}
                              </Button>
                              <Button variant="destructive" size="sm" onClick={() => confirmDelete(skill)}>
                                {language === 'ar' ? 'حذف' : 'Delete'}
                              </Button>
                            </div>
                          </TableCell>
                        </TableRow>
                      ))}
                    </TableBody>
                  </Table>
                </div>
              )}
            </CardContent>
          </Card>
        </div>
      </div>

      <AlertDialog open={deleteDialogOpen} onOpenChange={setDeleteDialogOpen}>
        <AlertDialogContent>
          <AlertDialogHeader>
            <AlertDialogTitle>
              {language === 'ar' ? 'تأكيد الحذف' : 'Confirm deletion'}
            </AlertDialogTitle>
            <AlertDialogDescription>
              {language === 'ar'
                ? 'هل أنت متأكد من حذف هذه المهارة؟ لا يمكن التراجع عن هذا الإجراء.'
                : 'Are you sure you want to delete this skill? This action cannot be undone.'}
            </AlertDialogDescription>
          </AlertDialogHeader>
          <AlertDialogFooter>
            <AlertDialogCancel>
              {language === 'ar' ? 'إلغاء' : 'Cancel'}
            </AlertDialogCancel>
            <AlertDialogAction disabled={deletingSkill} onClick={handleDelete}>
              {deletingSkill
                ? language === 'ar'
                  ? 'جارٍ الحذف…'
                  : 'Deleting…'
                : language === 'ar'
                  ? 'حذف المهارة'
                  : 'Delete skill'}
            </AlertDialogAction>
          </AlertDialogFooter>
        </AlertDialogContent>
      </AlertDialog>
    </div>
  )
}
